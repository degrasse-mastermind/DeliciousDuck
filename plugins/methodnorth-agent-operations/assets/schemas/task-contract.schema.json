{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://methodnorth.example/schemas/agent-operations-task-contract.json",
  "title": "Agent Operations Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "objective",
    "business_role",
    "work_mode",
    "scope",
    "out_of_scope",
    "acceptance_criteria",
    "dependencies",
    "authority",
    "approval",
    "callback",
    "conversation_key",
    "issue_number"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}-[0-9]{4}-[0-9]{3,}$" },
    "objective": { "type": "string", "minLength": 10 },
    "business_role": { "type": "string", "minLength": 3 },
    "work_mode": { "enum": ["plan", "implement", "review", "qa"] },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "out_of_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "external"],
      "properties": {
        "repository": { "enum": ["read-only", "working-tree", "pull-request"] },
        "external": { "enum": ["none", "draft-only", "approved-actions"] }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "revision"],
      "properties": {
        "status": { "enum": ["draft", "approved", "declined", "revoked"] },
        "revision": { "type": "integer", "minimum": 1 },
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "approved" } },
            "required": ["status"]
          },
          "then": { "required": ["approved_by", "approved_at"] }
        }
      ]
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved"],
      "properties": {
        "approved": { "type": "boolean" },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,200}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "approved": { "const": true } },
            "required": ["approved"]
          },
          "then": { "required": ["idempotency_key"] },
          "else": { "not": { "required": ["idempotency_key"] } }
        }
      ]
    },
    "conversation_key": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
    "issue_number": { "type": "integer", "minimum": 1 }
  }
}
